# ---------------------------------------------------------------------------
# Meeple Ledger — environment template.
# Copy to packages/backend/.env and packages/bot/.env (or set in your host).
# Never commit real secrets; only this example file is tracked.
# ---------------------------------------------------------------------------

# --- backend ---------------------------------------------------------------
# Postgres connection string. Matches docker-compose.yml for local dev.
DATABASE_URL="postgresql://meeple:meeple@localhost:5433/meeple?schema=public"
# Shared secret authorising bot -> API calls. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY="dev-service-key-change-me"
# HTTP port (most hosts inject their own PORT).
PORT="3000"

# --- bot -------------------------------------------------------------------
# Base URL of the backend API.
API_BASE_URL="http://localhost:3000"
# Discord bot token (Developer Portal -> Bot).
DISCORD_TOKEN="your-discord-bot-token"
# Application (client) id.
DISCORD_CLIENT_ID="your-discord-application-id"
# Server (guild) id — used for instant guild-scoped command registration in dev.
# Leave empty in production to register commands globally.
DISCORD_GUILD_ID="your-dev-guild-id"

# --- shared ----------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
