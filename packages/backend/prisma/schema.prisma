// Meeple Ledger — Prisma schema
// See PLAN.md §4 for the data model rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String          @id @default(cuid())
  realName        String? // the person's actual name — preferred everywhere we show a name
  discordName     String? // last-seen Discord server nickname; auto-synced, never shown once realName is set
  discordUserId   String?         @unique
  bggUsername     String?         @unique // BGG username, for collection import
  createdAt       DateTime        @default(now())
  participations  SessionPlayer[]
  createdSessions Session[]       @relation("CreatedBy")
  ratings         Rating[]
}

model Game {
  id            String    @id @default(cuid())
  name          String    @unique // the group's simple name — never overwritten by BGG
  bggId         Int?      @unique // BoardGameGeek id; the reliable link key
  bggName       String? // BGG's canonical (often verbose) name, for reference/search
  bggThumbnail  String? // URL to BGG thumbnail image
  description   String? // BGG short description
  yearPublished Int? // year the game was published
  minPlayers    Int?
  maxPlayers    Int?
  createdAt     DateTime  @default(now())
  sessions      Session[]
  ratings       Rating[]
}

model Location {
  id       String    @id @default(cuid())
  name     String    @unique
  sessions Session[]
}

model Session {
  id          String          @id @default(cuid())
  playedOn    DateTime // the date the game was played
  game        Game            @relation(fields: [gameId], references: [id])
  gameId      String
  location    Location?       @relation(fields: [locationId], references: [id])
  locationId  String?
  notes       String?
  createdBy   Player?         @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime        @default(now())
  players     SessionPlayer[]

  @@index([gameId])
  @@index([playedOn])
}

model SessionPlayer {
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  player    Player  @relation(fields: [playerId], references: [id])
  playerId  String
  isWinner  Boolean @default(false)
  score     Int?

  @@id([sessionId, playerId])
  @@index([playerId])
}

// A player's personal enjoyment rating (1–5) for a game — stated preference,
// independent of how often it's played or who wins. One row per (player, game),
// upserted. `value` is constrained to 1–5 at the API layer (Zod), matching the
// rest of the schema's validation style. Feeds the `/suggest` engine.
model Rating {
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  value     Int // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([playerId, gameId])
  @@index([gameId])
}
